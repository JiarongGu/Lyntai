<Project Sdk="Microsoft.NET.Sdk">

  <!-- samples/ is outside src/, so src/Directory.Build.props does not apply — set the shared bits here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CodePage>65001</CodePage>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lyntai.Core\Lyntai.Core.csproj" />
    <ProjectReference Include="..\..\src\Lyntai.Generation\Lyntai.Generation.csproj" />
  </ItemGroup>

  <!-- the workflow templates ride beside the binary, so a host runs the sample from anywhere -->
  <ItemGroup>
    <Content Include="templates\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
