<Project>

  <!--
    Single source of truth for the Lyntai library version (semver major.minor.patch), applied to every
    packable project under src/. devtools/project.config.mjs reads VersionPrefix from here so the package
    versions never drift from what the assemblies report. `dotnet pack -p:Version=X` overrides for a release.
  -->
  <PropertyGroup>
    <VersionPrefix>3.5.3</VersionPrefix>
  </PropertyGroup>

  <!-- Shared build settings for the whole tree. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BOM-less UTF-8 sources on a CJK-locale machine mojibake without this (csc reads them as ANSI). -->
    <CodePage>65001</CodePage>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Trim/AOT readiness: turns on IsTrimmable + the trim/AOT/single-file analyzers for every
         packable library. Lyntai.Storage.Sqlite opts OUT (Dapper/FluentMigrator materialize via
         reflection — an honest package can't claim AOT-compat there); see its csproj. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- NuGet metadata shared by the packable src/* projects (each sets its own PackageId + description). -->
  <PropertyGroup>
    <Authors>Jiarong Gu</Authors>
    <Product>Lyntai</Product>
    <PackageProjectUrl>https://github.com/JiarongGu/Lyntai</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JiarongGu/Lyntai</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>lyntai-icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/JiarongGu/Lyntai/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <!-- Shared by every package; a package APPENDS its own (`$(PackageTags);…`) for what only it serves. -->
    <PackageTags>llm;ai;dotnet;llm-router;fallback;openai;azure-openai;openrouter;ollama;llama-cpp;claude;claude-code;codex;mcp;rag;embeddings;ai-agents;agent-memory;prompt-registry;evals;llmops;tracing;opentelemetry</PackageTags>
  </PropertyGroup>

  <!-- Production packaging: XML docs ship in the package (missing-doc warnings suppressed — public
       surface is documented where it matters), portable PDBs in a .snupkg, and sources embedded in
       the PDB so consumers can step into library code without a hosted repo. SourceLink itself is
       SDK-included since .NET 8 (EnableSourceLink defaults true; no package reference needed) —
       PublishRepositoryUrl surfaces the repo URL in the package/PDB metadata alongside it. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Deterministic CI builds: normalized paths + reproducible outputs on any GitHub Actions build
       (both the push/PR verify and the release pack), never on local dev builds. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The repo README and the icon ship inside every package (PackageReadmeFile / PackageIcon above). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\docs\assets\lyntai-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
