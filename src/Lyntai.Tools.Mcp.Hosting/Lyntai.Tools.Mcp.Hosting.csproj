<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Lyntai.Tools.Mcp.Hosting</PackageId>
    <Description>The OUTBOUND half of Lyntai's MCP support: hosts the app's registered Lyntai ITools as an ephemeral, localhost-only HTTP MCP server so a CLI provider that runs its own agent loop can call them. Provider-neutral — a per-CLI IMcpCliDialect supplies the flags and config-file shapes (Lyntai.Providers.ClaudeCli ships one for `claude`). Wired via builder.AddMcpToolHost(dialect). Uses Kestrel (ASP.NET Core) for the per-call host.</Description>
    <!-- Hosts Kestrel: needs the ASP.NET Core shared framework. Dynamic-JSON tool marshaling + hosting
         mean this can't honestly claim trim/AOT. Analyzer stays on for our code. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- Kestrel/hosting comes from the ASP.NET Core shared framework (no extra NuGet weight). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyntai.Core\Lyntai.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lyntai.Tests" />
  </ItemGroup>

</Project>
