<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one-line install: `dotnet add package Lyntai` gets Core, the dependency-free default backends,
    in-memory storage, and BOTH halves of MCP. Everything with a heavy or platform-specific dependency stays an
    explicit opt-in — Lyntai.Storage.Sqlite's native binary, Lyntai.Providers.Local's LLamaSharp,
    Lyntai.Secrets.Dpapi's Windows-only API, Lyntai.Providers.ExtensionsAi's MEAI. See docs/DECISIONS.md D31.

    This is how "most consumers want X" is served WITHOUT putting X's dependencies in front of someone who only
    wanted storage: a metapackage is opt-in convenience, whereas Core is mandatory. MCP is included here rather
    than in Core precisely because of that split — it is near-universal in practice, but its SDK still pins a
    MEAI abstraction version, and Core must stay free of that.

    Ships NO assembly of its own (IncludeBuildOutput=false) — it is references only, so there is no public
    surface to baseline and nothing to load at runtime.

    Named "Bundle" rather than "Meta": NuGet's own term for this is "metapackage", but the project name is read
    by people deciding where code goes, and "a bundle of packages" says that without the jargon. The PUBLISHED
    id is unchanged and must stay `Lyntai` — that is what consumers install.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Lyntai</PackageId>
    <AssemblyName>Lyntai.Bundle</AssemblyName>
    <RootNamespace>Lyntai.Bundle</RootNamespace>
    <Description>The recommended STARTING set for Lyntai — not the whole library (6 of 12 packages). You get: the core library, the dependency-free LLM backends (claude/codex CLI, any OpenAI-compatible endpoint for chat + embeddings), the Microsoft.Extensions.AI bridge, both halves of MCP, and IN-MEMORY storage. Two things to know: storage is in-memory, so ADD Lyntai.Storage.Sqlite (or .Postgres) for anything that must survive a restart; and image/video/audio generation is NOT included — add Lyntai.Generation. Also opt-in: Lyntai.Providers.Local (local GGUF) and Lyntai.Secrets.Dpapi (Windows). Everything left out is left out because it drags a native payload, a platform-specific API, or an unverified surface.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <!-- nothing is compiled here, so the doc-file and trim analyzers have nothing to say -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- No assembly means no PDB, so the inherited IncludeSymbols would emit a symbol package containing
         nothing but a nuspec. The release pushes `*.nupkg` and `dotnet nuget push` sends each adjacent
         .snupkg automatically, so that empty one would be offered to nuget.org's symbol validation for no
         benefit whatsoever — and this metapackage is new, so that push has never been exercised. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyntai.Core\Lyntai.Core.csproj" />
    <ProjectReference Include="..\Lyntai.Providers.Default\Lyntai.Providers.Default.csproj" />
    <ProjectReference Include="..\Lyntai.Storage.InMemory\Lyntai.Storage.InMemory.csproj" />
    <ProjectReference Include="..\Lyntai.Tools.Mcp\Lyntai.Tools.Mcp.csproj" />
    <ProjectReference Include="..\Lyntai.Tools.Mcp.Hosting\Lyntai.Tools.Mcp.Hosting.csproj" />
    <!-- FREE to include: MCP already drags Microsoft.Extensions.AI.Abstractions transitively, so the bridge
         adds no new third-party dependency to the bundle's closure — 38 KB of managed code, 0 after trimming.
         See DECISIONS.md D32 for the rule this satisfies. -->
    <ProjectReference Include="..\Lyntai.Providers.ExtensionsAi\Lyntai.Providers.ExtensionsAi.csproj" />
  </ItemGroup>

</Project>
