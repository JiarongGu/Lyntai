<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The BASIC provider set, and "basic" is the membership RULE rather than a position in a list (D144):
    every backend that reaches a model needing nothing beyond Lyntai.Core, the BCL and the managed
    Microsoft.Extensions.Http. One package because their dependency footprint is the same (no native
    payload), so bundling costs a consumer nothing.

    A backend stays in a SEPARATE package when it drags something a consumer may not want (D25):
    Lyntai.Providers.LlamaSharp and Lyntai.Providers.Onnx (a native runtime), Lyntai.Storage.Sqlite (a native
    SQLite binary), Lyntai.Tools.Mcp (ModelContextProtocol.Core), Lyntai.Secrets.Dpapi (Windows-only).

    Namespaces are one segment per adapter (D154): Lyntai.Providers.ClaudeCli, .CodexCli, .Http (and
    .Http.Payloads), .Ollama and .Model2Vec, with Lyntai.Providers.Basic for what they share.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Lyntai.Providers.Basic</PackageId>
    <Description>The Lyntai backends that need nothing beyond Lyntai.Core and the BCL: the authenticated `claude` and `codex` CLIs (completions and self-driving agent sessions), any OpenAI-shaped HTTP endpoint (OpenAI, Azure OpenAI, OpenRouter, llama-server, LM Studio, vLLM) for chat, embeddings or reranking, Ollama's native API for chat and embeddings, and an in-process model2vec embedder — bundled because none of them ships a native payload. Media backends live in Lyntai.Generation; local GGUF inference is Lyntai.Providers.LlamaSharp; in-process transformers are Lyntai.Providers.Onnx.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyntai.Core\Lyntai.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- The only third-party reference here, and it must stay the only one: this package's whole membership
         rule is Core + the BCL, so anything added below moves a backend out of it. On the
         Microsoft.Extensions.* band D26 allows; the HTTP backend needs a named-client factory. -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lyntai.Tests" />
  </ItemGroup>

</Project>
