<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Lyntai.Providers.ClaudeCli.Mcp</PackageId>
    <Description>One-call wiring that gives the claude CLI provider proper tool-calling: builder.AddClaudeCliMcpTools() composes the generic MCP tool host (Lyntai.Tools.Mcp.Hosting) with the claude dialect (Lyntai.Providers.ClaudeCli), so the app's registered ITools are hosted per CLI call and the CLI's agent calls them natively. A convenience package — the two halves can also be composed directly via AddMcpToolHost(new ClaudeCliMcpDialect()).</Description>
    <!-- Composes the Kestrel-hosting package: inherits its trim/AOT posture. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- The one place in the tree where two adapters meet, and deliberately so: this package exists ONLY to
       compose them (see docs/DECISIONS.md D23). Its whole body is a single extension method — the host is
       provider-neutral and the dialect is dependency-free, so neither has to know about the other. -->
  <ItemGroup>
    <ProjectReference Include="..\Lyntai.Core\Lyntai.Core.csproj" />
    <ProjectReference Include="..\Lyntai.Tools.Mcp.Hosting\Lyntai.Tools.Mcp.Hosting.csproj" />
    <ProjectReference Include="..\Lyntai.Providers.ClaudeCli\Lyntai.Providers.ClaudeCli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lyntai.Tests" />
  </ItemGroup>

</Project>
