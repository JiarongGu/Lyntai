<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Lyntai.Core</PackageId>
    <Description>Lyntai core: LLM provider abstraction with routing + streaming-aware fallback, prompt registry, scoring/trace cortex interfaces, storage domain interfaces, and DI wiring (AddLyntai). No heavy dependencies — adapters live in separate Lyntai.* packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ONE internals door on this published assembly, and deliberately so. `Lyntai.Core` is not
         strong-named, so InternalsVisibleTo is matched on NAME alone and ships inside the nupkg — anything
         built as `Lyntai.Tests` can read every internal here. That is worth it for the test project, which
         must reach what it gates; it was not worth it for the bench, which needed two static string
         methods and now compile-LINKS their source file instead (bench/Lyntai.Benchmarks). -->
    <InternalsVisibleTo Include="Lyntai.Tests" />
  </ItemGroup>

</Project>
