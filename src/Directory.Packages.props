<Project>

  <!--
    Central package versions for the whole tree (single source — never put a Version on a
    PackageReference in a csproj). Projects under src/ find this file directly; tests/ and samples/
    reach it through the thin root-level Directory.Packages.props that imports this one.
  -->
  <ItemGroup>
    <!-- storage -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="FluentMigrator.Runner.SQLite" Version="8.0.1" />
    <PackageVersion Include="FluentMigrator.Runner.Postgres" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- Windows DPAPI (secret vault machine binding) — Windows-only at runtime, guarded in code -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />

    <!-- abstractions / DI / http -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />

    <!-- Microsoft.Extensions.AI.Abstractions has NO entry here on purpose (D146 deleted the bridge; nothing
         references it directly any more). Do not re-add one believing it pins MCP's transitive copy upward:
         `CentralPackageTransitivePinningEnabled` is off, so a PackageVersion without a PackageReference does
         nothing. Measured in project.assets.json — the entry said 10.8.0 and the restore resolved 10.5.2,
         ModelContextProtocol.Core's own. -->

    <!-- in-process local inference (managed only; the consumer app picks an LLamaSharp.Backend.*) -->
    <PackageVersion Include="LLamaSharp" Version="0.27.0" />

    <!-- Lyntai.Providers.Onnx: the MANAGED half of ONNX Runtime only — the C# API, no native binaries.
         The consuming app adds ONE backend (Microsoft.ML.OnnxRuntime for CPU, .DirectML for any DX12 GPU,
         .Gpu for CUDA), exactly as Lyntai.Providers.LlamaSharp leaves the LLamaSharp.Backend.* choice to
         the app. D68's rule: the library never picks the user's hardware. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.30.0" />

    <!-- MCP (Model Context Protocol) client — for exposing an MCP server's tools as Lyntai ITools -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.2.0" />

    <!-- tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- runtime-conditional skip ([SkippableFact] + Skip.IfNot) — xUnit v2 has no Assert.Skip; used to make
         the Postgres/Docker-gated tests report as SKIPPED (visible) rather than silently PASS -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- TEST-ONLY. It was the static embedder's tokenizer until that tokenizer was brought in-house: at
         325,896 B plus Google.Protobuf's 489,568 B it cost 812 KB of closure for one WordPiece call, and
         it kept the embedder out of the dependency-free Lyntai.Providers.Basic. It stays here as the
         reference WordPieceTokenizerTests asserts id-for-id equality against — which is also what found
         the two rules it gets wrong (tab/newline/CR are not word separators; accents are not stripped). -->
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <!-- OUTSIDE src/ ONLY, and it is the CONSUMER's step being exercised: Lyntai.Providers.Onnx references
         the managed half only, so something has to supply the native backend. The test project and the
         bench each add the CPU one exactly as an application would — which is also why a missing backend
         cannot hide behind a green suite. Never move this to src/: that would choose the user's hardware
         (D68). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />

    <!-- benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
