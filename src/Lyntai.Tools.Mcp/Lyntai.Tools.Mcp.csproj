<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Lyntai.Tools.Mcp</PackageId>
    <Description>MCP in BOTH directions. Exposes a Model Context Protocol server's tools as Lyntai ITools so the tool loop can call them, and hosts the app's registered ITools as an ephemeral, localhost-only MCP server for a CLI that runs its own agent loop. Wired via builder.AddMcpTools(...) and builder.AddMcpToolHost(...). Absorbed Lyntai.Tools.Mcp.Hosting, which pinned the same dependency and is retired.</Description>
    <!-- MCP argument/result marshaling is dynamic JSON (reflection): can't honestly claim trim/AOT. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyntai.Core\Lyntai.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lyntai.Tests" />
  </ItemGroup>

</Project>
