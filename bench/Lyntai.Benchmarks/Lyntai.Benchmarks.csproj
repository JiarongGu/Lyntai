<Project Sdk="Microsoft.NET.Sdk">

  <!-- bench/ is outside src/, so src/Directory.Build.props does not apply — set the shared bits here.
       Release-only: BenchmarkDotNet refuses to run a Debug build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CodePage>65001</CodePage>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lyntai.Core\Lyntai.Core.csproj" />
    <ProjectReference Include="..\..\src\Lyntai.Storage.Sqlite\Lyntai.Storage.Sqlite.csproj" />
    <!-- MemoryGistSupportSweep runs ~600 replays, and a fresh migrated SQLite database per replay is what
         makes memory-sweep slow by design. This study reads GraphNode.DecayState off an ENUMERATION rather
         than measuring ranking, so the in-process store is sufficient (pitfalls.md asks for SQLite when the
         subject IS ranking). Zero-dependency and Core-only, so it adds nothing to the build graph — the
         footprint that matters here, given what the comment below records about build-log size. -->
    <ProjectReference Include="..\..\src\Lyntai.Storage.Basic\Lyntai.Storage.Basic.csproj" />
    <!-- The IN-PROCESS arm of the cross-encoder study (TASKS.md Part 177). Every published reranker figure
         here was scored over HTTP against a llama-server, which cannot reach an ONNX file at all — so
         measuring one needs the adapter, and the adapter needs the native backend the app supplies. -->
    <ProjectReference Include="..\..\src\Lyntai.Providers.Onnx\Lyntai.Providers.Onnx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <!-- MemoryPolicySweep.cs reuses these two files VERBATIM (compile-time link, not a second copy) rather
       than re-deriving the mutation-tested corpus generator and recall-quality metric — a sweep over a
       drifted copy would measure something else entirely. Linked as FILES rather than a ProjectReference to
       Lyntai.Tests.csproj deliberately: that project also drags in Postgres/Testcontainers/MCP/Onnx/
       Generation + xunit, and doing so once measurably blew the check-warnings gate's full-solution
       `-v normal` build log past Node's spawnSync 1 MiB buffer (1,049,602 bytes captured, ENOBUFS) — `verify`
       reported "build FAILED" for a build that had in fact succeeded. Neither file needs anything beyond
       Lyntai.Core (already referenced above) and the BCL. -->
  <ItemGroup>
    <Compile Include="..\..\tests\Lyntai.Tests\Memory\Corpus\MemoryCorpus.cs" Link="Corpus\MemoryCorpus.cs" />
    <Compile Include="..\..\tests\Lyntai.Tests\Memory\Corpus\RecallQuality.cs" Link="Corpus\RecallQuality.cs" />
    <!-- Every template the corpus emits, plus the readers that parse it back. MemoryCorpus does not compile
         without it: the language axis routes every piece of text through this class. -->
    <Compile Include="..\..\tests\Lyntai.Tests\Memory\Corpus\CorpusLexicon.cs" Link="Corpus\CorpusLexicon.cs" />
    <!-- MemorySalienceSweep needs a deterministic IEmbedder: salience scores NOVELTY, which the engine only
         computes when an embedder AND a vector store are both supplied, and no harness ever supplied either
         (which is half of why salience had never been measured). Linked for the same reason as the two
         above — and it is the right file rather than a bench-local copy precisely because a second embedder
         would make "novel" mean something different here than it does in the tests. -->
    <Compile Include="..\..\tests\Lyntai.Tests\Fakes\FakeVectorProviderBase.cs" Link="Fakes\FakeVectorProviderBase.cs" />
    <Compile Include="..\..\tests\Lyntai.Tests\Fakes\FakeVectorProvider.cs" Link="Fakes\FakeVectorProvider.cs" />
    <!-- The similarity-index ADDRESS, linked for the same one-spelling reason and NOT reached through an
         InternalsVisibleTo. The locomo semantic control spelled it by hand, held `locomo|conv|scope` after
         the engine moved to U+001F, and reported "vectors=0" over a fully populated store — which reads as a
         dead retrieval channel rather than a stale probe (docs/FIXES.md, 2026-09-15). Linking the file gives
         the harness the owner's own source; granting the bench Core's internals would have given it every
         other one too, on an assembly that is published and not strong-named. -->
    <Compile Include="..\..\src\Lyntai.Core\Memory\MemoryVectorCollection.cs"
             Link="Memory\MemoryVectorCollection.cs" />
  </ItemGroup>

</Project>
